# 다른 컴퓨터용 설정 템플릿 — 이 파일을 ".env" 로 복사해서 값을 채우세요.
# ".env" 는 git 에 올라가지 않습니다. 값은 채팅/메신저/이메일에 붙여넣지 마세요.
# (원래 쓰는 컴퓨터의 .env 에서 아래 5개 값만 USB 등으로 옮겨 적으면 됩니다)

# 아임웹 기존 API 키 (고객 데이터 업데이트 등에 사용)
IMWEB_API_KEY=
IMWEB_SECRET_KEY=

# 아임웹 사이트 코드
IMWEB_SITE_CODE=

# 아임웹 Open API 앱 (배송대기 불러오기에 사용) — 토큰은 설치 중 자동 발급됩니다
IMWEB_GROUND_CLIENT_ID=
IMWEB_GROUND_CLIENT_SECRET=
IMWEB_GROUND_ACCESS_TOKEN=
IMWEB_GROUND_REFRESH_TOKEN=
